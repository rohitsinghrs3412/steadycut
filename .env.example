# Use a production Clerk application in production.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY must start with pk_live_.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY must be the matching sk_live_ key.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOY_KEY=
CLERK_JWT_ISSUER_DOMAIN=
GOOGLE_GENERATIVE_AI_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
STEADYCUT_LIVE_MODE=

# Sentry bug/error monitoring.
# Create a Sentry Next.js project, then paste its Client Key / DSN here.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Optional: used during production builds to upload source maps for readable stack traces.
SENTRY_AUTH_TOKEN=
SENTRY_ENVIRONMENT=

# In the Clerk dashboard, rename the production application display name to:
# SteadyCut
